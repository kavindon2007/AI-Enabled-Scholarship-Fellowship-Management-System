SMS_GATEWAY_URL=http://localhost:9999/sms
SMS_GATEWAY_API_KEY=test
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test
SMTP_PASSWORD=test
EMAIL_FROM=test@test.com

# --- Service Ports ---
