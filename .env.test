# ============================
# AI-SFMS Environment Variables (TEST)
# ============================

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sfms_test
POSTGRES_PASSWORD=test_password
POSTGRES_DB=sfms_test_db
DATABASE_URL=postgresql://sfms_test:test_password@localhost:5432/sfms_test_db

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/sfms_ocr_test
MONGODB_DB=sfms_ocr_test

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/1

# --- Kafka ---
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=sfms-test

# --- MinIO (S3-compatible) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=sfms_minio_admin
MINIO_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
MINIO_BUCKET=sfms-documents-test
MINIO_USE_SSL=false

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_AUDIT=audit_log_test

# --- JWT / Auth ---
JWT_SECRET=test_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Encryption ---
AADHAAR_HASH_SALT=test_salt
AES_ENCRYPTION_KEY=test_encryption_key_32_bytes_long

# --- External APIs (Mocked in test) ---
AZURE_DI_ENDPOINT=http://localhost:9999/azure
AZURE_DI_KEY=test
