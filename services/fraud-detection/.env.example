SERVICE_NAME=fraud-detection-service
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8003

# Risk Classification Thresholds (0.0 - 1.0)
LOW_RISK_THRESHOLD=0.25
MEDIUM_RISK_THRESHOLD=0.60
HIGH_RISK_THRESHOLD=0.85

# Database Configuration
POSTGRES_DSN=postgresql://sfms_user:sfms_pass@localhost:5432/sfms_fraud

# Cache Configuration
REDIS_URL=redis://localhost:6379/0

# ML Model Configuration
MODEL_VERSION=xgboost-v1.4-production
MODEL_ARTIFACT_PATH=/models/fraud_xgboost_v1.json
