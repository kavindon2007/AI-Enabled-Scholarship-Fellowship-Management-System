generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── APPLICANTS ───
model Applicant {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aadhaarHash     String   @unique @db.VarChar(64)
  name            String   @db.VarChar(200)
  dob             DateTime @db.Date
  gender          String   @db.VarChar(10)
  stateOfDomicile String   @db.VarChar(50)
  casteCategory   String   @default("ST") @db.VarChar(20)
  contactMobile   String?  @db.VarChar(10)
  contactEmail    String?  @db.VarChar(200)
  eKycVerified    Boolean  @default(false)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  lastLoginAt     DateTime @default(now()) @db.Timestamptz(6)

  bankAccounts BankAccount[]
  applications Application[]
  grievances   Grievance[]

  @@map("applicants")
}

// ─── BANK ACCOUNTS ───
model BankAccount {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicantId            String    @db.Uuid
  accountNumberEncrypted String    @db.Text
  ifscCode               String    @db.VarChar(11)
  bankName               String    @db.VarChar(100)
  accountHolderName      String    @db.VarChar(200)
  aadhaarSeedingStatus   String    @default("UNKNOWN") @db.VarChar(20) // ACTIVE, INACTIVE, NEVER_ENABLED, UNKNOWN
  seedingLastCheckedAt   DateTime? @db.Timestamptz(6)
  pfmsPennyDropStatus    String?   @db.VarChar(20)
  pennyDropCheckedAt     DateTime? @db.Timestamptz(6)
  isPrimary              Boolean   @default(true)

  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@map("bank_accounts")
}

// ─── SCHEMES ───
model Scheme {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeCode             String   @unique @db.VarChar(20)
  schemeName             String   @db.VarChar(200)
  schemeType             String   @db.VarChar(30)
  eligibilityRules       Json     @db.JsonB
  formConfig             Json     @db.JsonB
  docChecklist           Json     @db.JsonB
  quotaConfig            Json     @db.JsonB
  selectionMethod        String   @db.VarChar(20)
  scholarshipFormula     Json     @db.JsonB
  notificationTemplates  Json     @db.JsonB
  slaConfig              Json     @db.JsonB
  isActive               Boolean  @default(true)
  applicationWindowStart DateTime @db.Date
  applicationWindowEnd   DateTime @db.Date

  applications       Application[]
  eligibilityResults EligibilityResult[]
  disbursements      Disbursement[]
  grievances         Grievance[]
  schemeVersions     SchemeVersion[]

  @@map("schemes")
}

// ─── SCHEME VERSIONS (CONFIGURATIONS) ───
model SchemeVersion {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId      String @db.Uuid
  versionNumber Int
  status        String @default("DRAFT") @db.VarChar(30) // DRAFT, VALIDATED, PENDING_REVIEW, APPROVED, ACTIVE, SUPERSEDED, ARCHIVED

  // Display & Metadata
  schemeDescription    String? @db.Text
  localizationMetadata Json?   @db.JsonB

  // Lifecycle & Application Window
  applicationWindowStart DateTime? @db.Timestamptz(6)
  applicationWindowEnd   DateTime? @db.Timestamptz(6)

  // Modules
  eligibilityRules  Json  @db.JsonB // Still valid for simple rules, but RuleDefinition handles complex
  formConfig        Json  @db.JsonB
  verificationChain Json? @db.JsonB // Specifies sequence of verification (e.g. ['DIGILOCKER', 'MANUAL'])

  // Selection
  selectionMode       String @default("NONE") @db.VarChar(30) // NONE, THRESHOLD, MERIT_CASCADE, INTERVIEW_TIERS
  selectionParameters Json?  @db.JsonB
  quotaConfig         Json?  @db.JsonB

  // Renewal
  renewalMode  String @default("NO_RENEWAL") @db.VarChar(30) // NO_RENEWAL, ACADEMIC_YEAR, SEMESTER, etc
  renewalRules Json?  @db.JsonB

  // Disbursement & Payments
  disbursementMode   String @default("STATE_DBT") @db.VarChar(30) // STATE_DBT, CENTRAL_DBT, INSTITUTION_PAYMENT
  paymentComponents  Json?  @db.JsonB
  scholarshipFormula Json?  @db.JsonB

  // Operational
  notificationTemplates Json @db.JsonB
  slaConfig             Json @db.JsonB

  // Provenance & Validity
  ruleSource     String?   @db.Text
  lastVerifiedAt DateTime? @db.Timestamptz(6)
  effectiveFrom  DateTime? @db.Timestamptz(6)
  effectiveTo    DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  scheme               Scheme                @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  applications         Application[] // Track which version applied
  ruleDefinitions      RuleDefinition[]
  documentRequirements DocumentRequirement[]

  @@unique([schemeId, versionNumber])
  @@map("scheme_versions")
}

// ─── DOCUMENT REQUIREMENTS ───
model DocumentRequirement {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeVersionId       String   @db.Uuid
  documentType          String   @db.VarChar(50)
  displayName           String   @db.VarChar(200)
  isRequired            Boolean  @default(true)
  isConditional         Boolean  @default(false)
  condition             String?  @db.Text
  allowedMimeTypes      String[] @db.VarChar(50)
  maxSizeBytes          Int
  requiresOcr           Boolean  @default(false)
  requiresVerification  Boolean  @default(false)
  verificationAuthority String?  @db.VarChar(100)
  expiryPolicy          String?  @db.VarChar(50)
  replacementAllowed    Boolean  @default(true)
  helpText              String?  @db.Text
  localization          Json?    @db.JsonB

  schemeVersion SchemeVersion @relation(fields: [schemeVersionId], references: [id], onDelete: Cascade)

  @@unique([schemeVersionId, documentType])
  @@map("document_requirements")
}

// ─── RULE DEFINITIONS & PROVENANCE ───
model RuleDefinition {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeVersionId String   @db.Uuid
  ruleCode        String   @db.VarChar(50)
  ruleName        String   @db.VarChar(200)
  ruleType        String   @db.VarChar(50)
  sourceField     String   @db.VarChar(100)
  operator        String   @db.VarChar(20)
  value           Json?    @db.JsonB
  failureMode     String   @db.VarChar(50)
  failureMessage  Json?    @db.JsonB
  conditions      Json?    @db.JsonB
  exceptions      Json?    @db.JsonB
  priority        Int      @default(0)
  isEnabled       Boolean  @default(true)
  description     String?  @db.Text
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  schemeVersion SchemeVersion    @relation(fields: [schemeVersionId], references: [id], onDelete: Cascade)
  provenances   RuleProvenance[]

  @@map("rule_definitions")
}

model RuleProvenance {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ruleDefinitionId   String    @db.Uuid
  sourceType         String    @db.VarChar(50) // e.g. GAZETTE, MEMO
  sourceReference    String    @db.Text // e.g. "Gazette Notification No. 123"
  sourceTitle        String?   @db.Text
  sourcePage         String?   @db.VarChar(50)
  sourceSection      String?   @db.VarChar(100)
  sourceUrl          String?   @db.Text
  publishedDate      DateTime? @db.Date
  effectiveDate      DateTime? @db.Date
  verifiedAt         DateTime? @db.Timestamptz(6)
  verificationStatus String    @default("PENDING_AMENDMENT_CHECK") @db.VarChar(50) // VERIFIED, PENDING_AMENDMENT_CHECK, SUPERSEDED, DRAFT
  verifiedBy         String?   @db.Uuid
  notes              String?   @db.Text
  extractedAt        DateTime  @default(now()) @db.Timestamptz(6)

  ruleDefinition RuleDefinition @relation(fields: [ruleDefinitionId], references: [id], onDelete: Cascade)

  @@map("rule_provenance")
}

// ─── USERS (OFFICERS) ───
model User {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nicSsoId        String   @unique @db.VarChar(100)
  name            String   @db.VarChar(200)
  email           String   @unique @db.VarChar(200)
  role            String   @db.VarChar(50) // DATA_ENTRY_OPERATOR, SCRUTINY_OFFICER, etc.
  assignedSchemes String[] @db.VarChar(20) // Array of scheme_code
  assignedStates  String[] @db.VarChar(50)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  assignedApplications Application[]
  verifiedDocuments    Document[]
  overriddenResults    EligibilityResult[]
  assignedGrievances   Grievance[]         @relation("AssignedGrievances")
  escalatedGrievances  Grievance[]         @relation("EscalatedGrievances")

  @@map("users")
}

// ─── APPLICATIONS ───
model Application {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId              String    @db.Uuid
  schemeVersionId       String?   @db.Uuid
  applicantId           String    @db.Uuid
  academicYear          String    @db.VarChar(9)
  formData              Json      @db.JsonB
  status                String    @db.VarChar(30)
  riskScore             Int       @default(0)
  riskFlags             Json?     @db.JsonB
  submittedAt           DateTime? @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  lastUpdatedAt         DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  assignedOfficerId     String?   @db.Uuid
  isRenewal             Boolean   @default(false)
  previousApplicationId String?   @db.Uuid
  version               Int       @default(1)

  scheme          Scheme         @relation(fields: [schemeId], references: [id], onDelete: Restrict)
  schemeVersion   SchemeVersion? @relation(fields: [schemeVersionId], references: [id], onDelete: Restrict)
  applicant       Applicant      @relation(fields: [applicantId], references: [id], onDelete: Restrict)
  assignedOfficer User?          @relation(fields: [assignedOfficerId], references: [id], onDelete: SetNull)
  previousApp     Application?   @relation("RenewalChain", fields: [previousApplicationId], references: [id], onDelete: SetNull)
  renewedApps     Application[]  @relation("RenewalChain")

  documents          Document[]
  eligibilityResults EligibilityResult[]
  disbursements      Disbursement[]
  grievances         Grievance[]
  versions           ApplicationVersion[]
  transitions        WorkflowTransition[]
  deficiencies       Deficiency[]

  @@index([status])
  @@index([schemeId, status])
  @@index([applicantId, academicYear])
  @@index([status, assignedOfficerId])
  @@map("applications")
}

// ─── APPLICATION VERSIONS ───
model ApplicationVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String   @db.Uuid
  versionNumber Int
  formData      Json     @db.JsonB
  status        String   @db.VarChar(30)
  riskScore     Int      @default(0)
  riskFlags     Json?    @db.JsonB
  snapshotAt    DateTime @default(now()) @db.Timestamptz(6)
  actorId       String?  @db.Uuid // who made this change

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, versionNumber])
  @@map("application_versions")
}

// ─── DOCUMENTS ───
model Document {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId        String   @db.Uuid
  docType              String   @db.VarChar(50)
  storagePath          String   @db.Text
  originalFilename     String   @db.VarChar(255)
  fileSizeBytes        Int
  mimeType             String   @db.VarChar(50)
  checksumSha256       String?  @db.VarChar(64)
  ocrJobId             String?  @db.Uuid
  ocrStatus            String   @default("PENDING") @db.VarChar(20)
  ocrConfidenceOverall Decimal? @db.Decimal(4, 3)
  tamperingFlags       Json?    @db.JsonB
  verifiedStatus       String   @default("PENDING") @db.VarChar(20) // PENDING, VERIFIED, REJECTED, FLAGGED
  verifiedByOfficerId  String?  @db.Uuid
  uploadedAt           DateTime @default(now()) @db.Timestamptz(6)
  source               String   @default("MANUAL_UPLOAD") @db.VarChar(20)
  version              Int      @default(1)

  application       Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  verifiedByOfficer User?             @relation(fields: [verifiedByOfficerId], references: [id], onDelete: SetNull)
  versions          DocumentVersion[]

  @@index([applicationId, docType])
  @@map("documents")
}

// ─── DOCUMENT VERSIONS ───
model DocumentVersion {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId       String   @db.Uuid
  versionNumber    Int
  storagePath      String   @db.Text
  originalFilename String   @db.VarChar(255)
  fileSizeBytes    Int
  mimeType         String   @db.VarChar(50)
  checksumSha256   String?  @db.VarChar(64)
  uploadedAt       DateTime @default(now()) @db.Timestamptz(6)
  uploadedBy       String?  @db.Uuid

  document  Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  OCRJob    OCRJob[]
  OCRResult OCRResult[]

  @@unique([documentId, versionNumber])
  @@map("document_versions")
}

// ─── OCR CONFIG & PIPELINE ───
model OCRJob {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentVersionId String    @db.Uuid
  status            String    @db.VarChar(30) // QUEUED, PREPROCESSING, ENGINE_RUNNING, FUSING, VALIDATING, COMPLETED, PARTIAL, NEEDS_REVIEW, FAILED, CANCELLED
  processingProfile String    @db.VarChar(50)
  language          String    @default("en") @db.VarChar(10)
  startedAt         DateTime  @default(now()) @db.Timestamptz(6)
  completedAt       DateTime? @db.Timestamptz(6)
  errorMessage      String?   @db.Text

  documentVersion DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  attempts        OCRAttempt[]
  result          OCRResult?

  @@map("ocr_jobs")
}

model OCRAttempt {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ocrJobId             String    @db.Uuid
  engine               String    @db.VarChar(50)
  engineVersion        String?   @db.VarChar(50)
  status               String    @db.VarChar(30)
  rawText              String?   @db.Text
  confidence           Decimal?  @db.Decimal(4, 3)
  processingDurationMs Int?
  startedAt            DateTime  @default(now()) @db.Timestamptz(6)
  completedAt          DateTime? @db.Timestamptz(6)

  ocrJob OCRJob @relation(fields: [ocrJobId], references: [id], onDelete: Cascade)

  @@map("ocr_attempts")
}

model OCRResult {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ocrJobId          String   @unique @db.Uuid
  documentVersionId String   @db.Uuid
  overallConfidence Decimal? @db.Decimal(4, 3)
  pageCount         Int      @default(1)
  rawTextPreview    String?  @db.Text
  signatureDetected Boolean?
  stampDetected     Boolean?
  processedAt       DateTime @default(now()) @db.Timestamptz(6)

  ocrJob          OCRJob           @relation(fields: [ocrJobId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion  @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  fields          OCRFieldResult[]

  @@map("ocr_results")
}

model OCRFieldResult {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ocrResultId     String   @db.Uuid
  fieldKey        String   @db.VarChar(100)
  rawValue        String   @db.Text
  normalizedValue String?  @db.Text
  confidence      Decimal? @db.Decimal(4, 3)
  pageNumber      Int      @default(1)
  boundingBox     Json?    @db.JsonB
  engineSource    String   @db.VarChar(50)
  status          String   @db.VarChar(30) // HIGH_CONFIDENCE, MEDIUM_CONFIDENCE, LOW_CONFIDENCE, DISAGREEMENT, NOT_FOUND

  ocrResult   OCRResult         @relation(fields: [ocrResultId], references: [id], onDelete: Cascade)
  corrections FieldCorrection[]

  @@map("ocr_field_results")
}

model FieldCorrection {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ocrFieldResultId   String   @db.Uuid
  originalValue      String?  @db.Text
  correctedValue     String   @db.Text
  correctedByActorId String   @db.Uuid
  correctedAt        DateTime @default(now()) @db.Timestamptz(6)

  ocrFieldResult OCRFieldResult @relation(fields: [ocrFieldResultId], references: [id], onDelete: Cascade)

  @@map("field_corrections")
}

// ─── ELIGIBILITY RESULTS ───
model EligibilityResult {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId   String   @db.Uuid
  schemeId        String   @db.Uuid
  ruleSetVersion  String   @db.VarChar(20)
  outcome         String   @db.VarChar(20) // PASS, FAIL, DEFICIENT
  ruleResults     Json     @db.JsonB
  evaluatedAt     DateTime @default(now()) @db.Timestamptz(6)
  evaluatedBy     String   @default("AI") @db.VarChar(20) // AI, OFFICER
  officerOverride Boolean  @default(false)
  officerId       String?  @db.Uuid
  overrideReason  String?  @db.Text

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scheme      Scheme      @relation(fields: [schemeId], references: [id], onDelete: Restrict)
  officer     User?       @relation(fields: [officerId], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@map("eligibility_results")
}

// ─── VERIFICATIONS ───
model VerificationRecord {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId    String?  @db.Uuid
  applicationId String   @db.Uuid
  entityType    String   @db.VarChar(50) // e.g. "INCOME_CERTIFICATE", "CASTE_CERTIFICATE", "BANK_ACCOUNT"
  status        String   @db.VarChar(20) // VERIFIED, REJECTED, FLAG
  verifiedBy    String   @db.Uuid // Officer or System ID
  verifiedAt    DateTime @default(now()) @db.Timestamptz(6)
  evidence      Json?    @db.JsonB

  attempts VerificationAttempt[]

  @@map("verification_records")
}

model VerificationAttempt {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  verificationRecordId String   @db.Uuid
  provider             String   @db.VarChar(50) // e.g., "DIGILOCKER", "MANUAL_OFFICER"
  attemptedAt          DateTime @default(now()) @db.Timestamptz(6)
  resultStatus         String   @db.VarChar(20) // SUCCESS, FAILURE, TIMEOUT
  responsePayload      Json?    @db.JsonB // Audit trail of what adapter returned

  verificationRecord VerificationRecord @relation(fields: [verificationRecordId], references: [id], onDelete: Cascade)

  @@map("verification_attempts")
}

// ─── WORKFLOW TRANSITIONS ───
model WorkflowTransition {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId      String   @db.Uuid
  applicationVersion Int
  fromState          String   @db.VarChar(30)
  toState            String   @db.VarChar(30)
  actorId            String   @db.Uuid // ID of Applicant or Officer
  reason             String?  @db.Text
  transitionedAt     DateTime @default(now()) @db.Timestamptz(6)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("workflow_transitions")
}

// ─── DEFICIENCIES ───
model Deficiency {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String    @db.Uuid
  raisedBy      String    @db.Uuid // Officer ID
  raisedAt      DateTime  @default(now()) @db.Timestamptz(6)
  description   String    @db.Text
  fieldRef      String?   @db.VarChar(100)
  status        String    @default("OPEN") @db.VarChar(20) // OPEN, RESOLVED
  resolvedAt    DateTime? @db.Timestamptz(6)
  resolvedBy    String?   @db.Uuid // Applicant ID usually

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("deficiencies")
}

// ─── DISBURSEMENTS ───
model Disbursement {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId        String    @db.Uuid
  schemeId             String    @db.Uuid
  academicYear         String    @db.VarChar(9)
  installmentNumber    Int
  component            String    @db.VarChar(50) // TUITION, MAINTENANCE, etc.
  amount               Decimal   @db.Decimal(12, 2)
  currency             String    @default("INR") @db.VarChar(5)
  pfmsOrderId          String?   @db.VarChar(50)
  pfmsUtr              String?   @db.VarChar(50)
  status               String    @db.VarChar(20) // PENDING, CONFIRMED, etc.
  seedingCheckDate     DateTime? @db.Date
  seedingStatusAtCheck String?   @db.VarChar(20)
  attemptedAt          DateTime? @db.Timestamptz(6)
  confirmedAt          DateTime? @db.Timestamptz(6)
  failureReason        String?   @db.Text
  retryCount           Int       @default(0)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scheme      Scheme      @relation(fields: [schemeId], references: [id], onDelete: Restrict)

  @@index([applicationId])
  @@index([status])
  @@index([pfmsUtr])
  @@map("disbursements")
}

// ─── GRIEVANCES ───
model Grievance {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicantId     String    @db.Uuid
  applicationId   String?   @db.Uuid
  schemeId        String?   @db.Uuid
  category        String    @db.VarChar(50) // TECHNICAL, PAYMENT_ISSUE, etc.
  description     String    @db.Text
  status          String    @default("OPEN") @db.VarChar(20) // OPEN, RESOLVED, ESCALATED, etc.
  assignedTo      String?   @db.Uuid
  slaDeadline     DateTime  @db.Timestamptz(6)
  escalatedTo     String?   @db.Uuid
  escalationLevel Int       @default(1)
  resolutionNotes String?   @db.Text
  cpgramsRef      String?   @db.VarChar(50)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  resolvedAt      DateTime? @db.Timestamptz(6)

  applicant        Applicant    @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  application      Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  scheme           Scheme?      @relation(fields: [schemeId], references: [id], onDelete: SetNull)
  officer          User?        @relation("AssignedGrievances", fields: [assignedTo], references: [id], onDelete: SetNull)
  escalatedOfficer User?        @relation("EscalatedGrievances", fields: [escalatedTo], references: [id], onDelete: SetNull)

  @@index([applicantId])
  @@index([status, assignedTo])
  @@index([category, status])
  @@map("grievances")
}

// ─── AUDIT EVENTS ───
model AuditEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correlationId String?  @db.VarChar(100)
  actorId       String?  @db.Uuid
  actorType     String?  @db.VarChar(50) // APPLICANT, OFFICER, SYSTEM
  action        String   @db.VarChar(100)
  resourceType  String   @db.VarChar(50)
  resourceId    String?  @db.VarChar(100)
  details       Json?    @db.JsonB
  ipAddress     String?  @db.VarChar(45)
  userAgent     String?  @db.Text
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  @@index([action])
  @@index([actorId])
  @@index([resourceType, resourceId])
  @@map("audit_events")
}
