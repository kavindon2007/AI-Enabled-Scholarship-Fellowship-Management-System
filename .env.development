# ============================
# AI-SFMS Environment Variables
# ============================

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sfms_admin
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=sfms_applications
DATABASE_URL=postgresql://sfms_admin:CHANGE_ME_IN_PRODUCTION@localhost:5432/sfms_applications

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/sfms_ocr
MONGODB_DB=sfms_ocr

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Kafka ---
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=sfms

# --- MinIO (S3-compatible) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=sfms_minio_admin
MINIO_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
MINIO_BUCKET=sfms-documents
MINIO_USE_SSL=false

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_AUDIT=audit_log

# --- JWT / Auth ---
JWT_SECRET=CHANGE_ME_USE_RS256_IN_PRODUCTION
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Encryption ---
AADHAAR_HASH_SALT=CHANGE_ME_UNIQUE_PER_DEPLOYMENT
AES_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_KEY_BASE64_ENCODED

# --- Azure AI Document Intelligence (OCR) ---
AZURE_DI_ENDPOINT=https://YOUR_RESOURCE.cognitiveservices.azure.com/
AZURE_DI_KEY=CHANGE_ME

# --- NIC SSO (OpenID Connect) ---
NIC_SSO_ISSUER=https://sso.nic.in
NIC_SSO_CLIENT_ID=CHANGE_ME
NIC_SSO_CLIENT_SECRET=CHANGE_ME

# --- External APIs ---
UIDAI_AUA_CODE=CHANGE_ME
PFMS_API_URL=https://pfms.nic.in/api
PFMS_API_KEY=CHANGE_ME
NPCI_BASE_API_URL=https://BASE_API_ENDPOINT
NPCI_BASE_API_KEY=CHANGE_ME
DIGILOCKER_API_URL=https://api.digilocker.gov.in
DIGILOCKER_CLIENT_ID=CHANGE_ME
DIGILOCKER_CLIENT_SECRET=CHANGE_ME

# --- Communication ---
SMS_GATEWAY_URL=https://sms.gov.in/api
SMS_GATEWAY_API_KEY=CHANGE_ME
SMTP_HOST=smtp.gov.in
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
EMAIL_FROM=noreply@tribal.gov.in

# --- Service Ports ---
APPLICATION_SERVICE_PORT=3001
DOCUMENT_SERVICE_PORT=3002
COMMUNICATION_SERVICE_PORT=3003
GRIEVANCE_SERVICE_PORT=3004
DISBURSEMENT_SERVICE_PORT=3005
OCR_SERVICE_PORT=8001
ELIGIBILITY_ENGINE_PORT=8002
FRAUD_DETECTION_PORT=8003
SELECTION_SERVICE_PORT=8004

# --- Environment ---
NODE_ENV=development
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:5173
